---
// src/layouts/Header.astro
import { Image } from "astro:assets";
import ContentRenderer from "@/components/ContentRenderer/ContentRenderer.astro";
import Icon from "@/components/Icon";
import PrimaryBigButton from "@/components/Button/PrimaryBigButton";
import { find, related } from "@/utils/query";
import { siteData, ctaData } from "@/content/siteData";
import { formatPhoneNumber } from "@/utils/string";
import siteLogo from "@/assets/main-logo.png";

const phoneEntry = await find("contact-us", "phone");
const phoneValue = String(phoneEntry?.data?.description ?? "").trim();
const phoneHref =
  phoneValue && phoneEntry?.data?.linkPrefix ? `${phoneEntry.data.linkPrefix}${phoneValue}` : undefined;
const phoneLabel = String(phoneEntry?.data?.title ?? "").trim() || undefined;
---

<header id="site-header" class="sticky top-0 z-[40] shadow-md shadow-black/20">
  <div class="site-header bg-primary text-on-primary">

    <!-- ── DESKTOP layout (md+): phone | logo | CTA ── -->
    <div class="hidden md:grid w-full grid-cols-3 items-center gap-3 px-6 md:px-8 lg:px-10 xl:px-12">
      <!-- Phone (left) -->
      <div class="flex items-center gap-2">
        {phoneHref ? (
          <a
            href={phoneHref}
            class="flex items-center gap-2.5 text-on-primary hover:text-accent transition-colors duration-200"
            aria-label={phoneLabel}
          >
            <span class="flex flex-col leading-tight items-end">
              <span class="text-xs uppercase tracking-widest font-semibold text-on-primary/70">Call Us Today</span>
              <span class="flex items-center gap-1.5 text-lg font-black tracking-tight">
                <Icon icon="fa6:phone" size="sm" className="text-accent shrink-0" />
                {formatPhoneNumber(phoneValue)}
              </span>
            </span>
          </a>
        ) : (
          <span />
        )}
      </div>
      <!-- Logo (center) -->
      <a href="/" class="flex items-center justify-center hover:opacity-90 transition-opacity leading-none" aria-label={siteData.title}>
        <Image src={siteLogo} alt="Preferred Plumbing" id="site-logo" class="block w-auto object-contain" loading="eager" fetchpriority="high" />
      </a>
      <!-- CTA (right) -->
      <div class="flex items-center justify-end gap-3">
        <PrimaryBigButton href={ctaData.link} className="hidden lg:inline-flex text-sm xl:text-base px-4 xl:px-6 py-2.5 xl:py-3">
          {ctaData.text}
        </PrimaryBigButton>
      </div>
    </div>

    <!-- ── MOBILE layout (<md): hamburger top-right, logo centered, CTA + phone below ── -->
    <div class="md:hidden w-full flex flex-col px-4 pt-1 pb-2 gap-1">
      <!-- Row 1: logo centered, hamburger top-right -->
      <div class="relative flex items-center justify-center">
        <a href="/" class="flex items-center justify-center hover:opacity-90 transition-opacity leading-none" aria-label={siteData.title}>
          <Image src={siteLogo} alt="Preferred Plumbing" id="site-logo-mobile" class="block w-auto object-contain" loading="eager" fetchpriority="high" />
        </a>
        <div class="absolute right-0 top-1/2 -translate-y-1/2">
          <ContentRenderer
            query={related("menu-items", "menu", "main-menu")}
            variant="MenuVariant"
            mode="hamburger-only"
            className="header-navigation-mobile"
            hamburgerTransform={false}
            closeButton={true}
          />
        </div>
      </div>
      <!-- Row 2: CTA left, phone right -->
      <div class="flex items-center justify-between gap-1">
        <PrimaryBigButton href={ctaData.link} className="text-sm px-4 py-2.5 flex-shrink-0">
          {ctaData.text}
        </PrimaryBigButton>
        {phoneHref ? (
          <a
            href={phoneHref}
            class="flex items-center gap-2.5 text-on-primary hover:text-accent transition-colors duration-200"
            aria-label={phoneLabel}
          >
            <span class="flex flex-col leading-tight items-start">
              <span class="text-[0.6rem] uppercase tracking-widest font-semibold text-white">Call Us Today</span>
              <span class="flex items-center gap-1 text-base font-black tracking-tight">
                <Icon icon="fa6:phone" size="sm" className="text-accent shrink-0" />
                {formatPhoneNumber(phoneValue)}
              </span>
            </span>
          </a>
        ) : null}
      </div>
    </div>

  </div>

  <!-- Bottom nav bar: desktop only -->
  <div class="header-nav-bar bg-accent w-full py-1 hidden md:block">
    <div class="w-full flex items-center justify-center px-4 sm:px-6 md:px-8 lg:px-10 xl:px-12">
      <ContentRenderer
        query={related("menu-items", "menu", "main-menu")}
        variant="MenuVariant"
        mode="flat-only"
        className="header-navigation"
        hamburgerTransform={false}
        closeButton={true}
      />
    </div>
  </div>
</header>

<style>
  #site-logo {
    height: clamp(4rem, 8vw, 6.5rem);
    transition: height 400ms ease;
  }

  #site-logo-mobile {
    height: clamp(3.5rem, 18vw, 5rem);
  }

  #site-header[data-compact="true"] #site-logo {
    height: clamp(2.5rem, 5vw, 3.5rem);
  }

  @media (prefers-reduced-motion: reduce) {
    #site-logo { transition: none; }
  }
</style>

<script is:inline>
  const header = document.getElementById("site-header");
  if (header) {
    const setHeaderBottom = () => {
      const rect = header.getBoundingClientRect();
      document.documentElement.style.setProperty("--header-bottom", `${rect.bottom}px`);
    };

    // Compact logo on scroll — hysteresis prevents toggling at the threshold
    const COMPACT_ON  = 60;  // shrink when scrolled past this
    const COMPACT_OFF = 20;  // only expand once back above this
    let ticking = false;
    let isCompact = false;

    const updateCompact = () => {
      const y = window.scrollY;
      if (!isCompact && y > COMPACT_ON) {
        isCompact = true;
        header.setAttribute("data-compact", "true");
      } else if (isCompact && y < COMPACT_OFF) {
        isCompact = false;
        header.removeAttribute("data-compact");
      }
      setHeaderBottom();
      ticking = false;
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(updateCompact);
    };

    setHeaderBottom();
    const observer = new ResizeObserver(setHeaderBottom);
    observer.observe(header);

    window.addEventListener("resize", setHeaderBottom);
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  const menuRoot = header?.querySelector(".header-navigation .menu-desktop > ul");
  const topLevelItems = menuRoot?.querySelectorAll(":scope > li.menu-item") ?? [];

  const updateDropdownLeft = (el) => {
    if (!el) return;
    const rect = el.getBoundingClientRect();
    document.documentElement.style.setProperty("--menu-dropdown-left", `${rect.left}px`);
  };

  const closeAllTopLevelDropdowns = (exceptEl) => {
    topLevelItems.forEach((node) => {
      if (node !== exceptEl) node.classList.remove("is-open");
    });
  };

  topLevelItems.forEach((item) => {
    const trigger = item.querySelector(":scope > a[aria-haspopup='menu'], :scope > button[aria-haspopup='menu']");
    const dropdown = item.querySelector(":scope > .menu-dropdown");
    if (!trigger || !dropdown) return;

    const openDropdown = () => {
      closeAllTopLevelDropdowns(item);
      updateDropdownLeft(item);
      item.classList.add("is-open");
    };

    const closeDropdown = () => {
      item.classList.remove("is-open");
    };

    item.addEventListener("mouseenter", openDropdown);
    item.addEventListener("focusin", openDropdown);
    item.addEventListener("mouseleave", closeDropdown);
    item.addEventListener("focusout", (event) => {
      const nextTarget = event.relatedTarget;
      if (!nextTarget || !item.contains(nextTarget)) {
        closeDropdown();
      }
    });
  });

  document.addEventListener("click", (event) => {
    if (!menuRoot) return;
    if (!menuRoot.contains(event.target)) {
      closeAllTopLevelDropdowns();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeAllTopLevelDropdowns();
    }
  });
</script>
