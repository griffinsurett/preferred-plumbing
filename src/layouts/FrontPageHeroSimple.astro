---
// src/layouts/FrontPageHeroSimple.astro

import BackgroundMedia from "@/components/BackgroundMedia.astro";
import CertBadges from "@/components/Home/CertBadges.astro";
import HeroContent from "@/components/Home/HeroContent.astro";
import { siteData, ctaData } from "@/content/siteData";
import { find } from "@/utils/query";
import { formatPhoneNumber } from "@/utils/string";


export interface Props {
  title?: string;
  description?: string;
  image?: any;
  video?: {
    src?: string;
    autoPlay?: boolean;
    muted?: boolean;
    loop?: boolean;
    playsInline?: boolean;
    controls?: boolean;
    preload?: string;
    lazy?: boolean;
    poster?: string;
    generateThumbAt?: number;
    clientLoadPlaceholder?: boolean;
  };
  primaryCTA?: {
    text: string;
    link: string;
  };
  secondaryCTA?: {
    text: string;
    link: string;
    leftIcon?: any;
  };
  className?: string;
  id?: string;
  minHeight?: string;
}

const {
  title = "Welcome",
  description = siteData.description,
  image,
  video,
  primaryCTA = {
    text: ctaData.text,
    link: ctaData.link,
  },
  secondaryCTA,
  className = "",
  id = "hero",
} = Astro.props;

const heroBackgroundMedia = {
  video: {
    src: video?.src ?? "/hero-video.mp4",
    autoPlay: video?.autoPlay ?? true,
    muted: video?.muted ?? true,
    loop: video?.loop ?? true,
    playsInline: video?.playsInline ?? true,
    controls: video?.controls ?? false,
    preload: video?.preload ?? "metadata",
    lazy: video?.lazy ?? true,
    poster: video?.poster,
    generateThumbAt: video?.generateThumbAt ?? 0,
    clientLoadPlaceholder: video?.clientLoadPlaceholder ?? false,
    videoClass: "object-cover",
  },
  overlayClass: "bg-gradient-to-b from-black/80 via-black/30 to-black/70",
};

const phoneEntry = await find("contact-us", "phone");
const phoneValue = String(phoneEntry?.data?.description ?? "").trim();
const phoneHref =
  phoneValue && phoneEntry?.data?.linkPrefix ? `${phoneEntry.data.linkPrefix}${phoneValue}` : undefined;
const resolvedSecondaryCTA =
  secondaryCTA ||
  (phoneHref
    ? {
        text: formatPhoneNumber(phoneValue),
        link: phoneHref,
        leftIcon: phoneEntry?.data?.icon,
      }
    : undefined);

---

<section id={id} class={`relative bg-accent ${className}`}>
  <div class="relative min-h-[118vh] lg:min-h-[132vh]">
    <div class="relative h-[90vh] md:h-[100vh] overflow-hidden">
      <div class="absolute inset-0" aria-hidden="true">
        <BackgroundMedia backgroundMedia={heroBackgroundMedia} class="absolute inset-0" />
      </div>

      <div class="relative z-30 flex h-full w-full items-center justify-start px-8 md:px-12 lg:px-16 xl:px-20">
        <HeroContent
          title={title}
          primaryCTA={primaryCTA}
          secondaryCTA={resolvedSecondaryCTA}
        />
      </div>
    </div>

    <!-- Cert badges on the green -->
    <div class="relative z-30 w-full px-8 pt-10 pb-40 md:px-12 lg:px-16 xl:px-20">
      <CertBadges />
    </div>

  </div>
</section>

<style>
  h1,
  h2,
  p {
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
  }
</style>
